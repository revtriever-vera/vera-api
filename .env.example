NODE_ENV=development
IS_LOCAL=true
DEPLOY_ENV=local
PORT=3333
LOG_LEVEL=debug
DOCS_ENABLED=true
QUEUES_DASHBOARD_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=123456
QUEUES_DASHBOARD_USER=admin
QUEUES_DASHBOARD_PASSWORD=123456
CORS_ORIGINS=

DATABASE_URL=postgres://vera:vera@localhost:5437/vera
DATABASE_POOL_MAX=10

JWT_SECRET=dev-secret-do-not-use-in-prod
COOKIE_SECURE=false

APP_URL=http://localhost:5173
INVITE_TTL_DAYS=7
MEMBERS_MAX_PER_ACCOUNT=10

GOOGLE_CLIENT_ID=
# Google Agenda (hospedada): o client secret do mesmo app OAuth do login; na auto-hospedada valem as credenciais da aba Integrações.
# Drivers falsos (mock) só valem com IS_LOCAL=true; fora do local o valor é ignorado e vale o driver real (sem credencial, a função responde *.provider_disabled).
# GOOGLE_CALENDAR_DRIVER: mock (padrão no local, sem chamar o Google) ou google. O redirect padrão é PUBLIC_API_URL + /api/calendar/google/callback.
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_DRIVER=mock
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TIMEOUT_MS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0

CRYPTO_KEY_HEX=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

SECRET_SEALER_DRIVER=local
SECRET_SEALER_KMS_KEY_ID=
SECRET_SEALER_ALLOW_LOCAL_IN_PROD=
SECRET_SEALER_ALLOW_LEGACY_LOCAL=

REDIS_CLUSTER=true
REDIS_NODES=localhost:7200,localhost:7201,localhost:7202
REDIS_TLS=false
REDIS_DB=0
BULL_PREFIX={vera}

AWS_REGION=us-east-1

MAIL_DRIVER=smtp
MAIL_FROM_EMAIL=no-reply@vera.example
MAIL_FROM_NAME=Vera
MAIL_CONFIGURATION_SET=
SMTP_HOST=localhost
SMTP_PORT=1027
MAIL_ALLOWED_RECIPIENTS=*

OTEL_SERVICE_NAME=vera-api
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_VERSION=

CATALOG_DRIVER=mock
B3_INSTRUMENTS_URL=
TESOURO_PRICES_CSV_URL=https://www.tesourotransparente.gov.br/ckan/dataset/df56aa42-484a-4a59-8184-7676580c81e3/resource/796d2059-14e9-44e3-80c9-2d9e30b405c1/download/precotaxatesourodireto.csv
FINNHUB_API_KEY=
FINNHUB_BASE_URL=
COINGECKO_API_KEY=
COINGECKO_BASE_URL=
CATALOG_HTTP_TIMEOUT_MS=

FIXED_INCOME_INDEX_DRIVER=mock
SGS_BASE_URL=https://api.bcb.gov.br
SGS_CDI_SERIES_CODE=12
SGS_IPCA_SERIES_CODE=433
SGS_TIMEOUT_MS=10000

MARKET_DATA_DRIVER=mock
MARKET_DATA_HTTP_TIMEOUT_MS=
US_QUOTE_PROVIDERS=finnhub,twelvedata,alphavantage
BRAPI_TOKEN=
BRAPI_BASE_URL=
BRAPI_MAX_TICKERS_PER_REQUEST=
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_BASE_URL=
BCB_PTAX_BASE_URL=
BRAPI_LIMIT_MINUTE=
BRAPI_LIMIT_DAY=
BRAPI_LIMIT_MONTH=
FINNHUB_LIMIT_MINUTE=
FINNHUB_LIMIT_DAY=
FINNHUB_LIMIT_MONTH=
TWELVEDATA_LIMIT_MINUTE=
TWELVEDATA_LIMIT_DAY=
TWELVEDATA_LIMIT_MONTH=
ALPHAVANTAGE_LIMIT_MINUTE=
ALPHAVANTAGE_LIMIT_DAY=
ALPHAVANTAGE_LIMIT_MONTH=
COINGECKO_LIMIT_MINUTE=
COINGECKO_LIMIT_DAY=
COINGECKO_LIMIT_MONTH=

# Pluggy (Meu Pluggy). mock é o padrão local e dos testes: nenhuma chamada real à Pluggy.
# Endpoints e formatos marcados com "a validar no #14" ainda não foram confirmados contra a API real.
PLUGGY_DRIVER=mock
# a validar no #14: base, caminhos e timeout da API
PLUGGY_BASE_URL=
PLUGGY_AUTH_PATH=
PLUGGY_ITEM_PATH=
PLUGGY_HTTP_TIMEOUT_MS=
# a validar no #14: caminhos de contas e transações. PLUGGY_TRANSACTIONS_API=v2 usa o endpoint com cursor
# (/v2/transactions, dateFrom/dateTo/after, resposta {items,next}); legacy usa GET /transactions por página
# (page/pageSize 500), que a Pluggy remove em 2026-12-31. Só mude para legacy se a v2 não servir o conector.
PLUGGY_ACCOUNTS_PATH=
PLUGGY_TRANSACTIONS_V2_PATH=
PLUGGY_TRANSACTIONS_LEGACY_PATH=
PLUGGY_TRANSACTIONS_API=v2
# Sincronização: limite global da fila (a Pluggy limita por IP: 360 requisições por minuto em /auth, /accounts e
# /transactions; uma sincronização típica faz de 4 a 10), espaçamento do fan-out diário das 07:00 (America/Sao_Paulo),
# histórico da primeira sincronização (a validar no #14, pergunta 7) e deslocamento das datas das parcelas
# do cartão (liga conforme a pergunta 9 do #14).
PLUGGY_SYNC_JOBS_PER_MINUTE=30
PLUGGY_SYNC_SPACING_MS=2000
PLUGGY_INITIAL_HISTORY_DAYS=365
PLUGGY_SHIFT_INSTALLMENT_DATES=false
# Só com PLUGGY_DRIVER=mock. Client ID: qualquer uuid. Client Secret: "mock-invalid-secret" dá 401 e
# "mock-unavailable-secret" dá 503. Item IDs do mock:
#   00000000-0000-4000-8000-00000000a001  Nubank (nubank-checking e nubank-card)
#   00000000-0000-4000-8000-00000000a002  Itaú (itau-checking)
#   00000000-0000-4000-8000-00000000a404  não encontrado
#   00000000-0000-4000-8000-00000000a409  LOGIN_ERROR
MOCK_PLUGGY_FORCE_401=false
MOCK_PLUGGY_REVOKED_ITEMS=
DEPLOYMENT_MODE=hosted
PAID_USAGE_CAP_MICROS=4000000
PAID_USAGE_WARNING_BPS=8000
USAGE_USD_BRL_FALLBACK=5.0000
# vazio = padrão da Meta (Brasil, USD); informe só o que quiser sobrescrever
WHATSAPP_PRICE_TABLE={}
PAID_SEND_COST_MULTIPLIER=1
# Motor de Cobrança. fake (padrão no local): tudo em memória, com páginas de dev em /billing/_dev (só IS_LOCAL=true).
# revtriever: exige REVTRIEVER_API_KEY e REVTRIEVER_PLAN_ID fora do local (o plano sai de `npm run billing:provision`).
BILLING_ENGINE_DRIVER=fake
REVTRIEVER_API_URL=
REVTRIEVER_API_KEY=
REVTRIEVER_PLAN_ID=
REVTRIEVER_GATEWAY_CONNECTION_ID=
REVTRIEVER_TIMEOUT_MS=
REVTRIEVER_MAX_RETRIES=
# Só com BILLING_ENGINE_DRIVER=fake: derruba toda chamada ao motor; URL do webhook que recebe os eventos simulados (assinados com o segredo).
FAKE_BILLING_FORCE_FAILURE=false
FAKE_BILLING_PUBLIC_URL=
FAKE_BILLING_WEBHOOK_URL=
FAKE_BILLING_WEBHOOK_SECRET=
# Só para `npm run billing:provision`: endpoint público de preço da Vera e teto de preço, em centavos.
BILLING_PRICE_ENDPOINT_URL=
BILLING_PRICE_CEILING_CENTS=
# Integrações da versão auto-hospedada. Na hospedada valem as chaves da instância (AI_GATEWAY_API_KEY e LLM_MODEL); na auto-hospedada,
# cada company cadastra as suas em /integrations e estas variáveis só valem como reserva com INTEGRATIONS_INSTANCE_FALLBACK=true.
INTEGRATIONS_INSTANCE_FALLBACK=false
INTEGRATIONS_TEST_TIMEOUT_MS=
PUBLIC_API_URL=
AI_GATEWAY_BASE_URL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
WHATSAPP_GRAPH_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WABA_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Modelo de linguagem. mock (padrão no local) devolve respostas de fábrica; live exige credencial por conta ou AI_GATEWAY_API_KEY da instância.
LLM_DRIVER=mock
AI_GATEWAY_API_KEY=
# Modelo do driver mock e reserva quando a instância não define LLM_MODEL (acima); o modelo real da instância é LLM_MODEL.
LLM_MODEL_ID=meta/muse-spark-1.3-contributor
# JSON { "<modelo>": { "input": USD por milhão, "output": USD por milhão, "cacheRead": USD por milhão } }. Na hospedada com chave, o modelo precisa estar na tabela.
LLM_PRICE_TABLE={"meta/muse-spark-1.3-contributor":{"input":0.1,"output":0.2,"cacheRead":0.002}}
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_REPEAT_LIMIT=3
# WhatsApp (módulo whatsapp). mock (padrão no local) guarda os envios em memória e expõe /whatsapp/_dev; cloud fala com a Graph API da Meta.
WHATSAPP_DRIVER=mock
WHATSAPP_GRAPH_BASE_URL=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_HTTP_TIMEOUT_MS=
WHATSAPP_ALLOWED_RECIPIENTS=
WHATSAPP_TEMPLATES_AUTO_SUBMIT=
WHATSAPP_TEXT_RETENTION_DAYS=
WHATSAPP_DISPLAY_NUMBER=
# Vínculo do número (módulo whatsapp-link). A chave do HMAC do número é opcional: sem ela usa a CRYPTO_KEY_HEX.
WHATSAPP_LINK_CODE_TTL_MINUTES=
WHATSAPP_LINK_STALE_DAYS=
WHATSAPP_PHONE_HMAC_KEY=
# Conversa pelo WhatsApp (módulo whatsapp-chat): perguntas livres por pessoa e janela de junção de mensagens em rajada.
WHATSAPP_CHAT_LIMIT_MINUTE=
WHATSAPP_CHAT_LIMIT_DAY=
WHATSAPP_CHAT_COALESCE_MS=
# Lembretes pelo WhatsApp (módulo reminders): lembretes ativos por pessoa e disparos por template por conta no mês.
REMINDERS_MAX_ACTIVE=
REMINDERS_MAX_TEMPLATE_SENDS_MONTH=
