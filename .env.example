# Pluggy (Meu Pluggy). mock é o padrão local e dos testes: nenhuma chamada real à Pluggy.
# Endpoints e formatos marcados com "a validar no #14" ainda não foram confirmados contra a API real.
PLUGGY_DRIVER=mock
# a validar no #14: base, caminhos e timeout da API
PLUGGY_BASE_URL=
PLUGGY_AUTH_PATH=
PLUGGY_ITEM_PATH=
PLUGGY_HTTP_TIMEOUT_MS=
# a validar no #14: caminhos de contas e transações. PLUGGY_TRANSACTIONS_API=v2 usa o endpoint com cursor
# (/v2/transactions, dateFrom/dateTo/after, resposta {items,next}); legacy usa GET /transactions por página
# (page/pageSize 500), que a Pluggy remove em 2026-12-31. Só mude para legacy se a v2 não servir o conector.
PLUGGY_ACCOUNTS_PATH=
PLUGGY_TRANSACTIONS_V2_PATH=
PLUGGY_TRANSACTIONS_LEGACY_PATH=
PLUGGY_TRANSACTIONS_API=v2
# Sincronização: limite global da fila (a Pluggy limita por IP: 360 requisições por minuto em /auth, /accounts e
# /transactions; uma sincronização típica faz de 4 a 10), espaçamento do fan-out diário das 07:00 (America/Sao_Paulo),
# histórico da primeira sincronização (a validar no #14, pergunta 7) e deslocamento das datas das parcelas
# do cartão (liga conforme a pergunta 9 do #14).
PLUGGY_SYNC_JOBS_PER_MINUTE=30
PLUGGY_SYNC_SPACING_MS=2000
PLUGGY_INITIAL_HISTORY_DAYS=365
PLUGGY_SHIFT_INSTALLMENT_DATES=false
# Só com PLUGGY_DRIVER=mock. Client ID: qualquer uuid. Client Secret: "mock-invalid-secret" dá 401 e
# "mock-unavailable-secret" dá 503. Item IDs do mock:
#   00000000-0000-4000-8000-00000000a001  Nubank (nubank-checking e nubank-card)
#   00000000-0000-4000-8000-00000000a002  Itaú (itau-checking)
#   00000000-0000-4000-8000-00000000a404  não encontrado
#   00000000-0000-4000-8000-00000000a409  LOGIN_ERROR
MOCK_PLUGGY_FORCE_401=false
MOCK_PLUGGY_REVOKED_ITEMS=
